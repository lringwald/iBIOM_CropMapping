user_config.R

# Output data (per-user, regenerated by pipeline)
output/

# macOS Finder metadata
.DS_Store

# Condor working files (per-user)
Condor/

# Transient workspace snapshot (created per-run)
input/temp_image.RData

# R session files
.Rhistory
.RData
*.Rhistory
.Rproj.user/

